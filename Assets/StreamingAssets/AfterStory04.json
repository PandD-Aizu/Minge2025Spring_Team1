{
  "scenes": [
    {
      "id": 1,
      "name": "",
      "sentence": "戦いが終わった静寂の中、砕けた護符の光の粒子は一つに集い、\n一筋の光となって霧の奥へと飛んでいく。",
      "background": ""
    },
    {
      "id": 2,
      "name": "",
      "sentence": "まるで、道を示すかのように。\n私はそれに導かれるまま、歩き出す。",
      "background": ""
    },
    {
      "id": 3,
      "name": "",
      "sentence": "光の道筋の先に、それはあった。\n苔むした、古の石で組まれた「原初の祭壇」。",
      "background": ""
    },
    {
      "id": 4,
      "name": "",
      "sentence": "長かった旅が、ようやく終わる。\nそう思った、その時。",
      "background": ""
    },
    {
      "id": 5,
      "name": "",
      "sentence": "祭壇に近づくにつれ、空気が凍てつき、紫の霧が渦を巻いて濃密になっていく。",
      "background": ""
    },
    {
      "id": 6,
      "name": "",
      "sentence": "ギルベルト、ベネディクト、カトレアの“残影”たちが、\n明らかな警戒を示して私を庇うように前に出た。",
      "background": ""
    },
    {
      "id": 7,
      "name": "",
      "sentence": "祭壇の前。そこに、最後の“残影”が一人、静かに佇んでいた。",
      "background": ""
    },
    {
      "id": 8,
      "name": "",
      "sentence": "ローブを深く被り、その手には禍々しいオーラを放つ魔導書が握られている。",
      "background": ""
    },
    {
      "id": 9,
      "name": "",
      "sentence": "私たちの知恵の結晶、大魔法使い――エイミー。",
      "background": ""
    },
    {
      "id": 10,
      "name": "",
      "sentence": "彼女の“残影”だけが、まるで呪いの核心そのものであるかのように、この淀んだ魔力の中心にいた。",
      "background": ""
    },
    {
      "id": 11,
      "name": "",
      "sentence": "ゆっくりと顔を上げた彼女の瞳には、かつての優しさはなく、\nただ虚ろで、底なしの闇が広がっている。",
      "background": ""
    },
    {
      "id": 12,
      "name": "",
      "sentence": "最後の仲間が、最強の敵として、私の前に立ちはだかった。",
      "background": ""
    },
    {
      "id": 13,
      "name": "",
      "sentence": "",
      "background": ""
    }
  ]
}
{
  "scenes": [
    {
      "id": 1,
      "name": "",
      "sentence": "血と硝煙の匂いが混じり合う玉座で、私たちは確かに魔王を討ち果たした。",
      "background": "bg1.png"
    },
    {
      "id": 2,
      "name": "",
      "sentence": "長きにわたる冒険の終わりに、誰もが歓喜の声を上げようとした、その刹那――。",
      "background": "bg1.png"
    },
    {
      "id": 3,
      "name": "魔王",
      "sentence": "「――信じる者に裏切られる、その絶望を貴様らにも」",
      "background": "bg1.png"
    },
    {
      "id": 4,
      "name": "",
      "sentence": "断末魔の呪いが、空間そのものを震わせた。",
      "background": "bg1.png"
    },
    {
      "id": 5,
      "name": "",
      "sentence": "眩い光が弾け、仲間たちの歓声は断末魔の悲鳴へと変わる。",
      "background": "bg1.png"
    },
    {
      "id": 6,
      "name": "",
      "sentence": "彼らの瞳から理性の光が瞬く間に消え失せ、代わりに飢えと憎悪に満ちた光が宿る。",
      "background": "bg1.png"
    },
    {
      "id": 7,
      "name": "",
      "sentence": "目の前で、信じた仲間たちが、\nお互いを喰らい合う異形の「成れの果て（レヴナント）」へと成り果てていく。",
      "background": "bg1.png"
    },
    {
      "id": 8,
      "name": "",
      "sentence": "その地獄絵図を、私はただ立ち尽くして見ていることしかできなかった。",
      "background": "bg1.png"
    },
    {
      "id": 9,
      "name": "主人公",
      "sentence": "「あ……ぁ……ギルベルトさん……？」",
      "background": "bg1.png"
    },
    {
      "id": 10,
      "name": "",
      "sentence": "呼びかけに応える声はない。ただ、獣のような唸り声だけが返ってくる。",
      "background": "bg1.png"
    },
    {
      "id": 11,
      "name": "",
      "sentence": "そして、私の両腕には禍々しい呪いの紋様が浮かび上がっていた。",
      "background": ""
    },
    {
      "id": 12,
      "name": "",
      "sentence": "指先から、変わり果てた彼らへと繋がる、不快で冷たい魔力の糸を感じる。",
      "background": ""
    },
    {
      "id": 13,
      "name": "",
      "sentence": "私は、彼らを意のままに操れてしまう、\n呪われた「残影の魔女（レムナント・ウィッチ）」になってしまったのだ。",
      "background": ""
    },
    {
      "id": 14,
      "name": "主人公",
      "sentence": "「こんなの、あんまりじゃない……！」",
      "background": ""
    },
    {
      "id": 15,
      "name": "",
      "sentence": "ギルベルトさんの無双の剣技が、ベネディクトさんの正確無比な狙撃が、",
      "background": ""
    },
    {
      "id": 16,
      "name": "",
      "sentence": "カトレアさんの鉄壁の防御が、エイミーさんの叡智に満ちた魔法が、",
      "background": ""
    },
    {
      "id": 17,
      "name": "",
      "sentence": "今や私という呪いの発生源を守るためだけに存在する、空虚な力へと成り下がった。",
      "background": ""
    },
    {
      "id": 18,
      "name": "主人公",
      "sentence": "「みんな……」", 
      "background": ""
    },
    {
      "id": 19,
      "name": "",
      "sentence": "込み上げるのは、悲しみよりも、虚無。全てが無意味に思えた。",
      "background": ""
    },
    {
      "id": 20,
      "name": "",
      "sentence": "私は叫ぶことすら忘れ、崩れ落ちる。\nその微かな物音に、ダンジョンの魔物が嗅ぎつけてきた。",
      "background": ""
    },
    {
      "id": 21,
      "name": "主人公",
      "sentence": "（……ああ、もういい）",
      "background": ""
    },
    {
      "id": 22,
      "name": "",
      "sentence": "迫りくる魔物の顎が、目の前に迫る。",
      "background": ""
    },
    {
      "id": 23,
      "name": "主人公",
      "sentence": "（これで、終わらせてくれるんだ）",
      "background": ""
    },
    {
      "id": 24,
      "name": "",
      "sentence": "彼らのいない世界で、彼らの亡骸を使役して生き永らえるなど、拷問に等しい。\n私は静かに死を受け入れ、目を閉じた。",
      "background": ""
    },
    {
      "id": 25,
      "name": "",
      "sentence": "――ザシュッ！",
      "background": ""
    },
    {
      "id": 26,
      "name": "",
      "sentence": "しかし、訪れたのは安らかな死ではなく、肉を断つ生々しい音だった。",
      "background": ""
    },
    {
      "id": 27,
      "name": "",
      "sentence": "恐る恐る目を開けると、魔物は首を飛ばされ絶命していた。",
      "background": ""
    },
    {
      "id": 28,
      "name": "",
      "sentence": "その傍らには、かつてギルベルトさんだった「成れの果て」が、\n血に濡れた異形の腕を下げて佇んでいる。",
      "background": ""
    },
    {
      "id": 29,
      "name": "",
      "sentence": "私の“残影”が、私の意思とは無関係に、私を生かすために動いたのだ。",
      "background": ""
    },
    {
      "id": 30,
      "name": "",
      "sentence": "ああ、そうか。これが呪いの本質。これが、魔王の言った「絶望」。",
      "background": ""
    },
    {
      "id": 31,
      "name": "",
      "sentence": "ああ、そうか。これが呪いの本質。これが、魔王の言った「絶望」。",
      "background": ""
    },
    {
      "id": 32,
      "name": "",
      "sentence": "信じた仲間の亡骸に守られ、その亡骸を使役して生き延びろというのか。",
      "background": ""
    },
    {
      "id": 33,
      "name": "",
      "sentence": "死ぬことすら、許されない。これ以上の地獄があるだろうか。",
      "background": ""
    },
    {
      "id": 34,
      "name": "",
      "sentence": "脳裏に、唯一の可能性が浮かぶ。",
      "background": ""
    },
    {
      "id": 35,
      "name": "",
      "sentence": "ダンジョンの最上階にあるという「原初の祭壇」。",
      "background": ""
    },
    {
      "id": 36,
      "name": "",
      "sentence": "だが、それは希望と呼ぶにはあまりに遠く、あまりに残酷な道筋だった。",
      "background": ""
    },
    {
      "id": 37,
      "name": "",
      "sentence": "これは、光を探す旅ではない。",
      "background": ""
    },
    {
      "id": 38,
      "name": "",
      "sentence": "ただ、変わり果てた仲間たちをこのおぞましい呪縛から解放し、\nせめて安らかな眠りを与えるための、贖罪の巡礼。",
      "background": ""
    },
    {
      "id": 39,
      "name": "",
      "sentence": "血と涙で綴られる、終わりの見えない地獄の始まりだった。",
      "background": ""
    }
  ]
}
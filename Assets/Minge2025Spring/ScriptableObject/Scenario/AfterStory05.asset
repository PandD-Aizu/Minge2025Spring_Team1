    - id: 2
      name: 
      sentence: "\u7D2B\u8272\u306E\u9727\u306F\u6674\u308C\u3001\u67AF\u308C\u305F\u5927\u5730\u306B\u5149\u304C\u5DEE\u3057\u8FBC\u3080\u3002"
      background: 
    - id: 3
      name: 
      sentence: "\u5149\u306E\u4E2D\u3001\u30AE\u30EB\u30D9\u30EB\u30C8\u3001\u30D9\u30CD\u30C7\u30A3\u30AF\u30C8\u3001\u30AB\u30C8\u30EC\u30A2\u304C\u3001\n\u751F\u524D\u306E\u7A4F\u3084\u304B\u306A\u7B11\u9854\u3067\u79C1\u306B\u9837\u304D\u3001\u5929\u3078\u3068\u6607\u3063\u3066\u3044\u304F\u306E\u304C\u898B\u3048\u305F\u3002"
      background: 
    - id: 4
      name: 
      sentence: "\u305D\u3057\u3066\u3001\u8155\u306E\u4E2D\u306B\u3044\u305F\u306F\u305A\u306E\u30A8\u30A4\u30DF\u30FC\u306E\u4F53\u3082\u307E\u305F\u3001\n\u8DB3\u5143\u304B\u3089\u5149\u306E\u7C92\u5B50\u3068\u306A\u3063\u3066\u6D88\u3048\u3066\u3044\u304F\u3002"
      background: 
    - id: 5
      name: 
      sentence: "\u6700\u5F8C\u306B\u3001\u5F7C\u5973\u306E\u5507\u304C\u52D5\u3044\u305F\u3002"
      background: 

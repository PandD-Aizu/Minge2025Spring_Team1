      name: "\u30A8\u30A4\u30DF\u30FC"
      sentence: "\u300E\u2015\u2015\u3042\u308A\u304C\u3068\u3046\u300F"
      background: 
    - id: 7
      name: 
      sentence: "\u58F0\u306B\u306A\u3089\u306A\u3044\u58F0\u3060\u3051\u3092\u6B8B\u3057\u3066\u3001\u5F7C\u5973\u306F\u5B8C\u5168\u306B\u6D88\u6EC5\u3057\u305F\u3002"
      background: 
    - id: 8
      name: 
      sentence: "\u5168\u3066\u304C\u7D42\u308F\u308A\u3001\u591C\u304C\u660E\u3051\u308B\u3002\n\u4E16\u754C\u306F\u6551\u308F\u308C\u305F\u306E\u3060\u3002"
      background: 
    - id: 9
      name: 
      sentence: "\u546A\u3044\u306F\u89E3\u3051\u3001\u79C1\u306E\u8155\u304B\u3089\u798D\u3005\u3057\u3044\u7D0B\u69D8\u306F\u6D88\u3048\u3066\u3044\u305F\u3002\n\u201C\u6B8B\u5F71\u201D\u3092\u547C\u3073\u51FA\u3059\u529B\u3082\u3001\u3082\u3046\u306A\u3044\u3002"
      background: 
    - id: 10
      name: 
      sentence: "\u3053\u308C\u304C\u3001\u30CF\u30C3\u30D4\u30FC\u30A8\u30F3\u30C9\u3002\n\u4EF2\u9593\u305F\u3061\u306E\u72A0\u7272\u306E\u4E0A\u306B\u6210\u308A\u7ACB\u3064\u3001\u3042\u307E\u308A\u306B\u3082\u7A7A\u865A\u306A\u30CF\u30C3\u30D4\u30FC\u30A8\u30F3\u30C9\u3002"
      background: 
    - id: 11
      name: 
      sentence: "\u79C1\u306F\u3001\u89AA\u53CB\u3092\u3053\u306E\u624B\u3067\u6D88\u3057\u53BB\u3063\u305F\u3002\n\u305D\u306E\u7F6A\u3068\u8A18\u61B6\u3060\u3051\u304C\u3001\u79C1\u306E\u4E2D\u306B\u6C38\u9060\u306B\u6B8B\u308A\u7D9A\u3051\u308B\u3002"
      background: 
    - id: 12
      name: 
      sentence: "\u591C\u660E\u3051\u306E\u5149\u306B\u7167\u3089\u3055\u308C\u305F\u8352\u91CE\u306B\u3001\u4E00\u8F2A\u306E\u82B1\u304C\u54B2\u3044\u3066\u3044\u305F\u3002\n\u305D\u308C\u306F\u3001\u30A8\u30A4\u30DF\u30FC\u306E\u9AEA\u3068\u540C\u3058\u3001\u9BAE\u3084\u304B\u306A\u7D2B\u8272\u306E\u82B1\u3060\u3063\u305F\u3002"
      background: 
    - id: 13
      name: 
      sentence: "\u79C1\u306F\u305D\u306E\u82B1\u3092\u305D\u3063\u3068\u6458\u307F\u53D6\u308A\u3001\u518D\u3073\u6B69\u304D\u51FA\u3059\u3002"

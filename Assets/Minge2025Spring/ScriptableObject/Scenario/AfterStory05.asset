      sentence: "\u5168\u3066\u306E\u529B\u3092\u89E3\u304D\u653E\u3064\u3002\u6D44\u5316\u306E\u5149\u304C\u3001\n\u79C1\u3068\u30A8\u30A4\u30DF\u30FC\u3092\u4E2D\u5FC3\u306B\u3001\u4E16\u754C\u3078\u3068\u5E83\u304C\u3063\u3066\u3044\u304F\u3002"
